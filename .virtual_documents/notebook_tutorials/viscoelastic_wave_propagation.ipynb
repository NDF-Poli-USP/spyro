        "mesh_file": None,
        "mesh_type": "firedrake_mesh",
    },
    "acquisition": {
        "source_type": "ricker",
        "source_locations": [source_location],
        "frequency": frequency,
        "delay": 0.2,
        "delay_type": "time",
